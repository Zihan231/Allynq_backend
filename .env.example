# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
PORT=3001

# Application URLs
BACKEND_URL=https://allynq-backend.onrender.com

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
# Use separate, long random secrets in production (do not reuse JWT_SECRET).
TWO_FACTOR_ENCRYPTION_KEY=replace_with_32_or_more_random_characters
SECURITY_HASH_KEY=replace_with_32_or_more_random_characters
BACKUP_ENCRYPTION_KEY=replace_with_32_or_more_random_characters
# BACKUP_DIRECTORY=/persistent/path/to/backups

# Allowed Frontend Origins (CORS)
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://allync.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://allync.vercel.app
